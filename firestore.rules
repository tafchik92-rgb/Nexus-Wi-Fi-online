rules_version = '2';

// ============================================================
// NEXUS//POS — Firestore security rules
//
// These rules are the real authorization boundary. The client is
// assumed hostile: role and site scope come from custom claims minted
// by the signIn Cloud Function, never from anything the client sends.
// PIN material lives in staffAuth/, which no client may read or write.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn()  { return request.auth != null; }
    function claims()    { return request.auth.token; }
    function isAdmin()   { return signedIn() && claims().role == 'admin'; }
    function isStaff()   { return signedIn() && (claims().role == 'admin' || claims().role == 'agent'); }
    function uid()       { return request.auth.uid; }
    function mySites()   { return claims().siteIds; }

    // Admins reach every site; agents only the sites they are assigned.
    function atMySite(siteId) {
      return isAdmin() || (isStaff() && siteId in mySites());
    }

    // Suspension has to bite the moment it is set.
    //
    // Role and site scope ride in a custom token that stays valid for up to an
    // hour, and the token was all these rules read — so suspending an agent
    // who was already signed in did nothing until they signed out, and they
    // went on issuing vouchers and taking money in the meantime. The staff
    // directory is the live answer, so writes ask it.
    //
    // A member whose record has been deleted has no document to read, the
    // get() fails, and the write is refused — which is what should happen.
    function amActive() {
      return signedIn()
             && get(/databases/$(database)/documents/staff/$(uid())).data.status == 'active';
    }
    function activeAdmin() { return isAdmin() && amActive(); }
    function activeStaff() { return isStaff() && amActive(); }

    // Deliberately not applied to reads. A suspended till still needs to
    // receive the very update that suspends it — that is how the app knows to
    // close itself and say why. Cutting its listeners off instead leaves a
    // screen that has simply stopped working, which is the failure mode that
    // has already cost this shop an afternoon. Writes are the harm; reads are
    // what make stopping them visible.

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // Voucher prices are fixed by group — never taken from the client.
    function priceFor(type) {
      return type == 'V5' ? 5 : (type == 'V10' ? 10 : 0);
    }

    // ---------- staff PIN material: functions only ----------
    // The Admin SDK bypasses rules, so Cloud Functions still reach this.
    match /staffAuth/{staffId} {
      allow read, write: if false;
    }

    // ---------- staff directory ----------
    match /staff/{staffId} {
      allow read: if isStaff();
      // Creation and PIN changes go through Cloud Functions so that a
      // client can never mint itself an admin or set its own PIN.
      allow create: if false;
      allow update: if activeAdmin()
                    && unchanged('code')
                    && request.resource.data.role in ['admin', 'agent'];
      allow delete: if activeAdmin() && staffId != uid();
    }

    // ---------- sites ----------
    match /sites/{siteId} {
      allow read:   if isStaff();
      allow create: if activeAdmin() && request.resource.data.keys().hasAll(['name', 'code', 'status']);
      allow update: if activeAdmin();
      allow delete: if activeAdmin();
    }

    // ---------- vouchers ----------
    match /vouchers/{voucherId} {
      allow read:   if atMySite(resource.data.siteId);
      allow create: if activeAdmin() && request.resource.data.status == 'available';

      // Admins manage stock. Staff may only flip a voucher from available to
      // sold, at their own site, without rewriting its identity. The client
      // does this inside a Firestore transaction, so two tills racing for the
      // same code cannot both win — the loser retries and takes the next one.
      allow update: if activeAdmin()
                    || (
                      activeStaff() && atMySite(resource.data.siteId)
                      && resource.data.status == 'available'
                      && request.resource.data.status == 'sold'
                      && unchanged('code') && unchanged('type') && unchanged('siteId')
                    );

      allow delete: if activeAdmin() && resource.data.status == 'available';
    }

    // ---------- customer credit accounts ----------
    match /accounts/{accountId} {
      allow read:   if atMySite(resource.data.siteId);
      allow create: if activeStaff() && atMySite(request.resource.data.siteId)
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
      allow update: if activeStaff() && atMySite(resource.data.siteId) && unchanged('siteId');
      allow delete: if activeAdmin();
    }

    // ---------- sales: an append-only ledger ----------
    match /sales/{saleId} {
      allow read: if atMySite(resource.data.siteId);

      allow create: if activeStaff() && atMySite(request.resource.data.siteId)
                    // a sale is always booked to the staff member making it
                    && request.resource.data.agentId == uid()
                    && request.resource.data.type in ['V5', 'V10', 'REC']
                    && request.resource.data.price == priceFor(request.resource.data.type)
                    && request.resource.data.pay in ['cash', 'credit']
                    // free vouchers can never be sold on credit
                    && (request.resource.data.pay == 'cash' || request.resource.data.price > 0);

      // Immutable once written — corrections are new records, not edits.
      allow update, delete: if false;
    }

    // ---------- settlements: also append-only ----------
    // A payment carries its account's siteId. Looking the account up instead
    // could be checked for a single document but never for a query, so agents
    // could not list settlements at all — and a balance computed without them
    // shows a customer still owing money they have already paid.
    match /payments/{paymentId} {
      allow read: if isStaff() && (
                    atMySite(resource.data.siteId)
                    // records written before siteId was carried here
                    || (!('siteId' in resource.data)
                        && atMySite(get(/databases/$(database)/documents/accounts/$(resource.data.accountId)).data.siteId))
                  );

      allow create: if activeStaff()
                    && request.resource.data.receivedBy == uid()
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.method in ['cash', 'mobile', 'bank']
                    && atMySite(request.resource.data.siteId)
                    // the stamped site must be the account's own
                    && request.resource.data.siteId ==
                       get(/databases/$(database)/documents/accounts/$(request.resource.data.accountId)).data.siteId;

      // Immutable, with one exception: an admin may stamp the site onto an
      // older record that predates the field. Nothing else may change.
      allow update: if activeAdmin()
                    && !('siteId' in resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['siteId'])
                    && request.resource.data.siteId ==
                       get(/databases/$(database)/documents/accounts/$(resource.data.accountId)).data.siteId;
      allow delete: if false;
    }

    // ---------- reversals: undoing a sale without erasing it ----------
    // A sale stays immutable. Cancelling one appends a reversal that points at
    // it, so the ledger shows both the original and the correction — which is
    // the whole reason the sales collection is append-only. Deleting the sale
    // would leave a voucher back in stock with nothing to explain why.
    match /reversals/{reversalId} {
      allow read: if isStaff() && atMySite(resource.data.siteId);

      // Administrators only: reversing moves money and returns stock.
      allow create: if activeAdmin()
                    && request.resource.data.reversedBy == uid()
                    && request.resource.data.saleId is string
                    && request.resource.data.saleId.size() > 0
                    && request.resource.data.siteId is string
                    && request.resource.data.outcome in ['restocked', 'voided'];

      // A correction is itself part of the record.
      allow update, delete: if false;
    }

    // ---------- month-end closings ----------
    match /closings/{closingId} {
      allow read:   if isAdmin() || (isStaff() && resource.data.userId == uid());
      // An agent closes their own month; nobody rewrites a closed period.
      allow create: if activeStaff() && request.resource.data.userId == uid();
      allow update: if false;
      allow delete: if activeAdmin();
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
